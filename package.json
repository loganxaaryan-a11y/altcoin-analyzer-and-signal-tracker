{
  "name": "hatch-ts-space-altcoin-analyzer-and-signal-tracker",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "typecheck": "bun x tsc --noEmit -p client/tsconfig.json && bun x tsc --noEmit -p server/tsconfig.json",
    "test:module": "bun test server/src/signal-methodology.test.ts",
    "test:integration": "bun test server/src/signal-persistence.integration.test.ts",
    "test:action": "bun test server/src/signal-action-contract.integration.test.ts",
    "test:measurement": "bun test server/src/measurement-recovery.test.ts server/src/measurement-database.integration.test.ts server/src/measurement-action.integration.test.ts server/src/factor-ledger-compat.test.ts server/src/signal-methodology.test.ts",
    "test:phase2a": "bun test server/src/phase2a-research.test.ts",
    "test:phase2a1": "bun test server/src/phase2a-research.test.ts",
    "test:freshness": "bun test server/src/market-freshness.test.ts",
    "test:discovery-repair": "bun test server/src/discovery-repair.test.ts",
    "research:phase2a": "bun research/phase2a/cli.ts",
    "build": "bun run build:server && bun run build:client",
    "build:server": "cd server && bun build ./src/actions.ts --target=bun --outfile=./dist/actions.js",
    "build:client": "bun ./client/build.mjs"
  },
  "dependencies": {
    "@hatch/space-sdk": "file:vendor/space-sdk-0.13.0.tgz",
    "@tanstack/react-query": "5.100.10",
    "drizzle-orm": "0.45.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "2.15.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "5.6.3"
  }
}
