{
  "compilerOptions": {
    "declaration": false,
    "esModuleInterop": true,
    "module": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "sourceMap": false,
    "strict": true,
    "target": "ES2022",
    "types": [
      "node"
    ],
    "moduleResolution": "NodeNext"
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}